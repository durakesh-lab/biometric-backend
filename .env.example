# ── Backend environment template ─────────────────────────────
# Copy to ".env" and fill in real values. NEVER commit the real .env.
#
#   cp .env.example .env
#
# ─────────────────────────────────────────────────────────────

# MongoDB Atlas connection string (rotate the password regularly).
# Format: mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
mongodb_cluster_url=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/biometric

# (optional) raw DB password if referenced elsewhere
database_cluster_password=CHANGE_ME

# JWT signing secret — REQUIRED. Use a long random string (e.g. 64 hex chars).
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# ── EasyWDMS / biometric device sync (Phase 3 — fill when integrating) ──
# WDMS_BASE_URL=http://127.0.0.1:8000
# WDMS_USERNAME=admin
# WDMS_PASSWORD=CHANGE_ME

# SMTP for 2FA OTP emails (server-side only; never in the UI/DB)
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-16-char-app-password
